# Backend Environment Variables Template
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pujacircle

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_here

# ImageKit Storage Configuration (Priest Profiles & Document Verification)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/pujacircle

# Abstracted OTP SMS Gateway (Provider Agnostic)
OTP_PROVIDER_API_KEY=your_otp_provider_key
