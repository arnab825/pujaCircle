# Frontend Environment Variables Template
# Copy this file to .env or .env.local for local development

# Base URL for the future Backend API.
# Note: In Phase 1 initial scaffolding, the frontend uses the functional mock API layer in `src/mocks/`
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable/disable artificial mock delay in ms (default: 400ms)
VITE_MOCK_DELAY_MS=400
